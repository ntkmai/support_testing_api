# MongoDB Atlas Connection
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Database Name
DB_NAME=api_test_tool

# Server Port
PORT=3001

# Environment
NODE_ENV=development

# ============================================
# HƯỚNG DẪN CẤU HÌNH
# ============================================

# 1. Lấy MongoDB Connection String:
#    - Đăng nhập vào MongoDB Atlas (https://cloud.mongodb.com)
#    - Chọn cluster của bạn
#    - Click "Connect" > "Connect your application"
#    - Copy connection string
#    - Thay <username> và <password> bằng thông tin thực

# 2. Whitelist IP Address:
#    - Vào MongoDB Atlas > Network Access
#    - Add IP Address
#    - Cho phép 0.0.0.0/0 (development) hoặc IP cụ thể (production)

# 3. Create Database User:
#    - Vào MongoDB Atlas > Database Access
#    - Add New Database User
#    - Cấp quyền "Read and write to any database"

# 4. Tạo file .env từ file này:
#    - Copy file .env.example thành .env
#    - Điền thông tin thực của bạn
